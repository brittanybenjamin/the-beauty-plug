							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-Medium.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-MediumItalic.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-SemiBold.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-SemiBoldItalic.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-Bold.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-BoldItalic.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "800",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-ExtraBold.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "800",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-ExtraBoldItalic.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "900",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-Black.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "900",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-BlackItalic.woff2"
							]
						}
					],
					"fontFamily": "Literata, serif",
					"name": "Literata",
					"slug": "literata"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Ysabeau Office\"",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/ysabeau-office/YsabeauOffice-VariableFont_wght.woff2"
							]
						},
						{
							"fontFamily": "\"Ysabeau Office\"",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/ysabeau-office/YsabeauOffice-Italic-VariableFont_wght.woff2"
							]
						}
					],
					"fontFamily": "\"Ysabeau Office\", sans-serif",
					"name": "Ysabeau Office",
					"slug": "ysabeau-office"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1rem"
					},
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.375rem",
						"min": "1.125rem"
					},
					"name": "Large",
					"size": "1.38rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2rem",
						"min": "1.75rem"
					},
					"name": "Extra Large",
					"size": "1.75rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "2.6rem",
						"min": "1.4rem"
					},
					"name": "Extra Extra Large",
					"size": "2.6rem",
					"slug": "xx-large"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "1.25rem"
				}
			},
			"core/post-terms": {
				"variations": {
					"post-terms-1": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--medium)"
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "900",
					"letterSpacing": "-0.96px"
				}
			},
			"core/pullquote": {
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--medium)",
							"letterSpacing": "-0.14px"
						}
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"core/query-title": {
				"typography": {
					"fontWeight": "900"
				}
			},
			"core/quote": {
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--medium)",
							"letterSpacing": "-0.14px"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ysabeau-office)",
					"letterSpacing": "1.6px",
					"textTransform": "uppercase"
				}
			}
		},
		"color": {
			"background": "#f1ddd4"
		},
		"elements": {
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--literata)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "900",
					"letterSpacing": "-0.36px"
				}
			},
			"h5": {
				"typography": {
					"letterSpacing": "0px"
				}
			},
			"h6": {
				"typography": {
					"fontWeight": "900",
					"letterSpacing": "0px"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--literata)",
					"fontWeight": "900",
					"lineHeight": "1.2"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--ysabeau-office)",
			"letterSpacing": "-0.24px",
			"textAlign": "center"
		}
	}
}