							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/literata/Literata72pt-Regular.woff2"
							]
						},
						{
							"fontFamily": "Literata",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
